// Cultivation Progression App - Database Schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  friendCode String  @unique @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns     CheckIn[]
  settings     UserSettings?
  checkInNotes CheckInNote[]
  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
}

model FriendRequest {
  id          String   @id @default(cuid())
  requesterId String
  receiverId  String
  status      String   @default("pending") // pending | accepted | rejected | cancelled
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  requester User @relation("FriendRequestSender", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
}

model UserSettings {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id])
  dualPageView    Boolean @default(false)
  pinnedNavItems  String  @default("[]")
  hiddenNavItems  String  @default("[]")
  panelPosition   String  @default("left")
  combinedView    Boolean @default(false)
}

model CheckIn {
  id        String   @id @default(cuid())
  date      DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weight    Float?
  comment   String?
  present   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([date, userId])
  @@index([userId])
}

model Exercise {
  id          String  @id @default(cuid())
  name        String
  wuxiaName   String?
  difficulty  String
  type        String
  story       String?
  targetGroup String?
  assignedDays String @default("") // Comma-separated list of days: "0,1,2" for Sun,Mon,Tue
  createdAt   DateTime @default(now())
}

model CheckInNote {
  id        String   @id @default(cuid())
  date      String              // "YYYY-MM-DD" date string
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, userId])
  @@index([userId])
}

// ── Progression Module ──

model ProgressionExercise {
  id              String   @id @default(cuid())
  name            String
  wuxiaName       String   @default("")
  difficulty      String   @default("")   // Wuxia difficulty name (e.g. "Mortal", "Foundation Establishment")
  wuxiaDifficulty String   @default("")   // Explicit wuxia difficulty from new JSON format
  type            String   @default("")   // Wuxia type / cultivation path (e.g. "Upper Heaven")
  wuxiaType       String   @default("")   // Explicit wuxia type from new JSON format
  story           String   @default("")
  tips            String   @default("")   // JSON array stored as string
  category        String
  equipmentType   String                  // e.g. "bar", "floor", "rings"
  bodyweight      Boolean  @default(true)
  weighted        Boolean  @default(false)
  rings           Boolean  @default(false)
  primaryMuscles  String                  // comma-separated
  secondaryMuscles String  @default("")   // comma-separated
  prerequisites   String   @default("[]") // JSON array of {name, minimumReps, minimumHold, notes}
  cues            String   @default("[]") // JSON array of coaching cue strings
  commonMistakes  String   @default("[]") // JSON array of {mistake, correction}
  breathing       String   @default("")
  safetyConsiderations String @default("[]") // JSON array of strings
  competitionStandards String @default("{}")  // JSON object
  assignedDays    String   @default("")   // Comma-separated list of days: "0,1,2" for Sun,Mon,Tue
  createdAt       DateTime @default(now())
  userId          String

  tiers      ProgressionTier[]
  variations ProgressionVariation[]
  modifiers  ProgressionModifier[]
  userProgress UserProgressionLevel[]

  @@index([userId])
}

model ProgressionTier {
  id            String   @id @default(cuid())
  exerciseId    String
  exercise      ProgressionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  level         Int
  name          String
  wuxiaName     String   @default("")
  difficulty    String   @default("")   // Wuxia difficulty name
  wuxiaDifficulty String @default("")
  wuxiaType     String   @default("")
  description   String   @default("")
  targetHold    Int?                      // target hold time in seconds
  targetReps    Int?                      // target reps (numeric) if applicable
  targetRepsText String  @default("")    // target reps as string like "3-5" or "5-8"

  @@index([exerciseId])
}

model ProgressionVariation {
  id            String   @id @default(cuid())
  exerciseId    String
  exercise      ProgressionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  name          String
  wuxiaName     String   @default("")
  difficulty    String   @default("")   // Wuxia difficulty name
  wuxiaDifficulty String @default("")
  wuxiaType     String   @default("")
  description   String   @default("")

  @@index([exerciseId])
}

model ProgressionModifier {
  id                String   @id @default(cuid())
  exerciseId        String
  exercise          ProgressionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  type              String              // "rings" | "weighted" | "slow tempo" | "supinated grip" | custom
  available         Boolean  @default(false)
  difficultyMod     Float    @default(0) // e.g. +0.5 difficulty bump
  notes             String   @default("")
  method            String   @default("")  // e.g. "Ankle weights or weight vest"
  difficultyIncrease String  @default("") // e.g. "+1 level per 5% bodyweight added"

  @@index([exerciseId])
}

model UserProgressionLevel {
  id            String   @id @default(cuid())
  userId        String
  exerciseId    String
  exercise      ProgressionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  currentLevel  Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logs ProgressionLog[]

  @@unique([userId, exerciseId])
  @@index([userId])
  @@index([exerciseId])
}

model ProgressionLog {
  id                  String   @id @default(cuid())
  userProgressionId   String
  userProgression     UserProgressionLevel @relation(fields: [userProgressionId], references: [id], onDelete: Cascade)
  level               Int
  weight1             Float?
  reps1               Int?
  weight2             Float?
  reps2               Int?
  weight3             Float?
  reps3               Int?
  holdTime            Int?      // seconds achieved (set 1)
  holdTime2           Int?      // seconds achieved (set 2)
  holdTime3           Int?      // seconds achieved (set 3)
  reps                Int?      // legacy single reps field
  modifier            String?   // selected modifier type (e.g. "rings", "weighted")
  variant             String?   // selected variation name
  notes               String?
  completed           Boolean   @default(false)  // marked level as completed
  createdAt           DateTime  @default(now())

  @@index([userProgressionId])
}
