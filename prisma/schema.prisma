// Cultivation Workout App - Database Schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns     CheckIn[]
  workouts     Workout[]
  settings     UserSettings?
  checkInNotes CheckInNote[]
}

model UserSettings {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id])
  dualPageView    Boolean @default(false)
  pinnedNavItems  String  @default("[]")
  hiddenNavItems  String  @default("[]")
  panelPosition   String  @default("left")
  combinedView    Boolean @default(false)
}

model CheckIn {
  id        String   @id @default(cuid())
  date      DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weight    Float?
  comment   String?
  present   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([date, userId])
  @@index([userId])
}

model Exercise {
  id          String  @id @default(cuid())
  name        String
  wuxiaName   String?
  difficulty  String
  type        String
  story       String?
  targetGroup String?
  assignedDays String @default("") // Comma-separated list of days: "0,1,2" for Sun,Mon,Tue
  createdAt   DateTime @default(now())

  simplifiedWorkouts SimplifiedWorkoutExercise[]
  detailedWorkouts   DetailedWorkoutExercise[]
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime @default(now())
  notes     String?
  targetGroups String? // Auto-assigned comma-separated muscle groups derived from exercises
  createdAt DateTime @default(now())

  simplifiedExercises SimplifiedWorkoutExercise[]
  detailedExercises   DetailedWorkoutExercise[]

  @@index([userId])
}

model SimplifiedWorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  weight1    Float?
  reps1      Int?
  weight2    Float?
  reps2      Int?
  weight3    Float?
  reps3      Int?
  holdTime   Int?
  notes      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([workoutId])
  @@index([exerciseId])
}

model DetailedWorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  weight1    Float?
  reps1      Int?
  weight2    Float?
  reps2      Int?
  weight3    Float?
  reps3      Int?
  notes      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([workoutId])
  @@index([exerciseId])
}

model CheckInNote {
  id        String   @id @default(cuid())
  date      String              // "YYYY-MM-DD" date string
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, userId])
  @@index([userId])
}

// ── Progression Module ──

model ProgressionExercise {
  id              String   @id @default(cuid())
  name            String
  wuxiaName       String   @default("")
  difficulty      String   @default("")
  type            String   @default("")
  story           String   @default("")
  tips            String   @default("")   // JSON array stored as string
  category        String
  equipmentType   String                  // e.g. "bar", "floor", "rings"
  bodyweight      Boolean  @default(true)
  weighted        Boolean  @default(false)
  rings           Boolean  @default(false)
  primaryMuscles  String                  // comma-separated
  secondaryMuscles String  @default("")   // comma-separated
  assignedDays    String   @default("")   // Comma-separated list of days: "0,1,2" for Sun,Mon,Tue
  createdAt       DateTime @default(now())
  userId          String

  tiers      ProgressionTier[]
  variations ProgressionVariation[]
  modifiers  ProgressionModifier[]
  userProgress UserProgressionLevel[]

  @@index([userId])
}

model ProgressionTier {
  id            String   @id @default(cuid())
  exerciseId    String
  exercise      ProgressionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  level         Int
  name          String
  wuxiaName     String   @default("")
  difficulty    String   @default("")
  description   String   @default("")
  targetHold    Int?                      // target hold time in seconds
  targetReps    Int?                      // target reps if applicable

  @@index([exerciseId])
}

model ProgressionVariation {
  id            String   @id @default(cuid())
  exerciseId    String
  exercise      ProgressionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  name          String
  wuxiaName     String   @default("")
  difficulty    String   @default("")
  description   String   @default("")

  @@index([exerciseId])
}

model ProgressionModifier {
  id                String   @id @default(cuid())
  exerciseId        String
  exercise          ProgressionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  type              String              // "rings" | "weighted"
  available         Boolean  @default(false)
  difficultyMod     Float    @default(0) // e.g. +0.5 difficulty bump
  notes             String   @default("")

  @@index([exerciseId])
}

model UserProgressionLevel {
  id            String   @id @default(cuid())
  userId        String
  exerciseId    String
  exercise      ProgressionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  currentLevel  Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logs ProgressionLog[]

  @@unique([userId, exerciseId])
  @@index([userId])
  @@index([exerciseId])
}

model ProgressionLog {
  id                  String   @id @default(cuid())
  userProgressionId   String
  userProgression     UserProgressionLevel @relation(fields: [userProgressionId], references: [id], onDelete: Cascade)
  level               Int
  weight1             Float?
  reps1               Int?
  weight2             Float?
  reps2               Int?
  weight3             Float?
  reps3               Int?
  holdTime            Int?      // seconds achieved (set 1)
  holdTime2           Int?      // seconds achieved (set 2)
  holdTime3           Int?      // seconds achieved (set 3)
  reps                Int?      // legacy single reps field
  modifier            String?   // selected modifier type (e.g. "rings", "weighted")
  variant             String?   // selected variation name
  notes               String?
  completed           Boolean   @default(false)  // marked level as completed
  createdAt           DateTime  @default(now())

  @@index([userProgressionId])
}
